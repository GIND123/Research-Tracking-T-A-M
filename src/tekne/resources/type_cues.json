  "orthographic": {
    "_comment": "Each entry is [name, regex, weight]. Fired against the raw surface.",
    "patterns": [
      ["all_caps_acronym", "^[A-Z][A-Z0-9]{1,7}(?:-[A-Z0-9]{1,4})?$", 2.2],
      ["camel_case", "^[A-Z][a-z]+(?:[A-Z][a-z0-9]+)+$", 2.4],
      ["versioned", "\\b(?:v?\\d+(?:\\.\\d+)+|-\\d+[Bb]|\\d+[BbMm])\\b", 1.8],
