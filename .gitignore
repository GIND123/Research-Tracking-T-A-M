.venv/
.env
.env.local
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store

# Regenerated artefacts.
#
# The evaluation corpora are the exception and ARE tracked: the gold file is
# offset-anchored into those exact documents, and `make data` cannot reproduce
# them -- the arXiv query is sorted by submission date descending, so re-running
# it returns whatever is newest that day and every gold offset becomes wrong.
# Without them the gold set is 895 annotations pointing at nothing.
data/raw/*
!data/raw/papers_eval.jsonl
!data/raw/patents_eval.jsonl
!data/raw/papers_trend.jsonl
data/interim/

# The knowledge base is regenerable: `make kb` pulls a version-pinned CSO 3.4.
data/kb/

# Run outputs, except the evaluation results the report reads and that make the
# quoted numbers auditable without a re-run.
runs/*
!runs/eval/
runs/eval/*
!runs/eval/results.json
!runs/eval/risk_coverage.json
!runs/eval/error_analysis.json
*.egg-info/

# LaTeX build products
report/*.aux
report/*.bbl
report/*.blg
report/*.log
report/*.out
report/*.fdb_latexmk
report/*.fls
report/*.synctex.gz
